WEATHERGPT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WEATHERGPT_KAFKA_OBSERVATION_WRITER_GROUP_ID=weathergpt-observation-writers-v1
WEATHERGPT_KAFKA_CONSUMER_MAX_POLL_RECORDS=50
WEATHERGPT_KAFKA_CONSUMER_MAX_POLL_INTERVAL_MS=300000
WEATHERGPT_REDIS_URL=redis://localhost:6379/0
WEATHERGPT_DATABASE_URL=postgresql+psycopg://weathergpt:weathergpt@localhost:5432/weathergpt
WEATHERGPT_DATABASE_POOL_MIN_SIZE=2
WEATHERGPT_DATABASE_POOL_MAX_SIZE=10
WEATHERGPT_OPEN_METEO_BASE_URL=https://api.open-meteo.com
WEATHERGPT_NOAA_BASE_URL=https://api.weather.gov

# Configure when an approved IMD API/feed endpoint is available.
# WEATHERGPT_IMD_BASE_URL=https://api.imd.gov.in/...

# Configure when a WIS2.0 MQTT broker is available.
# WEATHERGPT_WIS2_MQTT_HOST=globalbroker.meteo.example
# WEATHERGPT_WIS2_MQTT_PORT=8883
# WEATHERGPT_WIS2_MQTT_USERNAME=
# WEATHERGPT_WIS2_MQTT_PASSWORD=
# WEATHERGPT_WIS2_MQTT_TOPIC=origin/a/wis2/#

# WeatherGPT local/production-like environment variables.
# Copy to .env for local development and replace all secrets/credentials.

WEATHERGPT_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
WEATHERGPT_REDIS_URL=redis://redis:6379/0
WEATHERGPT_DATABASE_URL=postgresql+psycopg://weathergpt:CHANGE_ME@timescaledb:5432/weathergpt

# IMD official API configuration.
# Station IDs must be verified against authoritative IMD station metadata.
WEATHERGPT_IMD_BASE_URL=https://api.imd.gov.in
WEATHERGPT_IMD_STATION_IDS={"delhi":"42182"}

# WIS2/MQTT (optional in Phase 1)
# WEATHERGPT_WIS2_MQTT_HOST=
# WEATHERGPT_WIS2_MQTT_USERNAME=
# WEATHERGPT_WIS2_MQTT_PASSWORD=
# WEATHERGPT_WIS2_MQTT_TOPIC=origin/a/wis2/#
